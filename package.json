{
  "name": "chess-lens",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts e2e *.json *.ts *.md .github",
    "format:check": "prettier --check src scripts e2e *.json *.ts *.md .github",
    "engine:prepare": "node scripts/prepare-engine.mjs",
    "postinstall": "npm run engine:prepare"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stockfish": "19.0.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "fake-indexeddb": "6.2.6",
    "jsdom": "^29.0.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
